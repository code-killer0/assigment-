# Final Optimal Ops Assistant Configuration
# HuggingFace with Structured Output Parsing

# ============================================
# REQUIRED: HuggingFace API Token
# ============================================
# Get free token: https://huggingface.co/settings/tokens
# Create a "Read" token and paste it here

HUGGINGFACE_API_TOKEN=your_hf_token_here

# ============================================
# Model Selection
# ============================================
# Recommended models for SQL generation:

# Option 1: Google Gemma 2 2B (Fast, lightweight) ⭐ DEFAULT
MODEL_NAME=google/gemma-2-2b-it

# Option 2: Mistral 7B (Better accuracy, slightly slower)
# MODEL_NAME=mistralai/Mistral-7B-Instruct-v0.2

# Option 3: CodeLlama 7B (Best for SQL, requires more resources)
# MODEL_NAME=codellama/CodeLlama-7b-Instruct-hf

# Option 4: CodeLlama 13B (Best accuracy, slower)
# MODEL_NAME=codellama/CodeLlama-13b-Instruct-hf

# Option 5: Llama 2 7B Chat (Good balance)
# MODEL_NAME=meta-llama/Llama-2-7b-chat-hf

# ============================================
# Model Parameters
# ============================================

# Temperature (0 = deterministic, 1 = creative)
TEMPERATURE=0.1

# Maximum new tokens to generate
MAX_TOKENS=512

# ============================================
# Optional: Enable Verbose Logging
# ============================================
VERBOSE=false

# ============================================
# Optional: LangSmith Tracing (for debugging)
# ============================================
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your-langsmith-key
# LANGCHAIN_PROJECT=ops-assistant-final
